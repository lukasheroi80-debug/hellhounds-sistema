rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // V4.1 sem Firebase Authentication: o controle de acesso acontece no painel.
    // Publique estas regras para o primeiro teste. Para produção pública,
    // migre a autenticação para um backend seguro antes de divulgar o link.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
